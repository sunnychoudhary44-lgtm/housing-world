{
  "entities": {
    "leads": {
      "title": "Leads",
      "description": "Real estate property inquiries and customer leads",
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Unique numeric ID of the lead"
        },
        "name": {
          "type": "string",
          "description": "Name of the client"
        },
        "mobile": {
          "type": "string",
          "description": "10-digit Indian mobile number"
        },
        "project": {
          "type": "string",
          "description": "Interested real estate project"
        },
        "budget": {
          "type": "string",
          "description": "Client budget range"
        },
        "status": {
          "type": "string",
          "description": "Current pipeline status"
        },
        "salesperson": {
          "type": "string",
          "description": "Assigned executive name"
        },
        "leadType": {
          "type": "string",
          "description": "Lead classification category"
        },
        "priority": {
          "type": "string",
          "description": "Lead urgency priority level"
        },
        "followup": {
          "type": "string",
          "description": "ISO date for next scheduled follow-up"
        },
        "remarks": {
          "type": "string",
          "description": "Discussion notes and conversation history"
        },
        "createdDate": {
          "type": "string",
          "description": "ISO date when the lead was received"
        }
      },
      "required": ["id", "name", "mobile", "status", "salesperson"]
    },
    "calls": {
      "title": "Calls",
      "description": "Phone call interactions and telecalling logs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the call log"
        },
        "leadId": {
          "type": "number",
          "description": "Associated lead ID if applicable"
        },
        "leadName": {
          "type": "string",
          "description": "Name of the contacted customer"
        },
        "mobile": {
          "type": "string",
          "description": "Phone number contacted"
        },
        "salesperson": {
          "type": "string",
          "description": "Executive who initiated or received the call"
        },
        "callType": {
          "type": "string",
          "description": "Outbound or Inbound call"
        },
        "outcome": {
          "type": "string",
          "description": "Call outcome or disposition"
        },
        "durationSeconds": {
          "type": "number",
          "description": "Call duration in seconds"
        },
        "notes": {
          "type": "string",
          "description": "Key takeaways from the call"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp when the call was recorded"
        }
      },
      "required": ["id", "salesperson", "outcome", "timestamp"]
    },
    "users": {
      "title": "Users",
      "description": "Registered CRM accounts with credentials, role, and contact information",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the user"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user"
        },
        "mobile": {
          "type": "string",
          "description": "10-digit mobile number"
        },
        "username": {
          "type": "string",
          "description": "User ID or username chosen by user"
        },
        "password": {
          "type": "string",
          "description": "User account password"
        },
        "role": {
          "type": "string",
          "description": "Account role: admin or user"
        },
        "designation": {
          "type": "string",
          "description": "Job title or designation in company"
        },
        "avatarColor": {
          "type": "string",
          "description": "Tailwind color class for avatar badge"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp"
        }
      },
      "required": ["id", "name", "username", "password", "role"]
    },
    "developers": {
      "title": "Developers",
      "description": "Real estate developers, builders, promoters, and corporate groups",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "name": { "type": "string", "description": "Developer name" },
        "brandName": { "type": "string", "description": "Brand trade name" },
        "reraNumber": { "type": "string", "description": "RERA registration number" },
        "contactPerson": { "type": "string", "description": "Liaison or sales head" },
        "contactPhone": { "type": "string", "description": "Official phone number" },
        "contactEmail": { "type": "string", "description": "Official email address" },
        "headOffice": { "type": "string", "description": "Head office location" },
        "gstin": { "type": "string", "description": "GST registration number" },
        "status": { "type": "string", "description": "Active or Inactive" },
        "mandateType": { "type": "string", "description": "Exclusive or Preferred or Open" },
        "commissionTerms": { "type": "string", "description": "Agreed commission / brokerage percentage" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "name", "contactPhone"]
    },
    "projects": {
      "title": "Projects",
      "description": "Real estate projects, towers, plotted developments, and commercial hubs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "name": { "type": "string", "description": "Project marketing title" },
        "developerId": { "type": "string", "description": "Linked developer ID" },
        "developerName": { "type": "string", "description": "Name of developer" },
        "location": { "type": "string", "description": "Sector / micro-market location" },
        "city": { "type": "string", "description": "City of project" },
        "reraNumber": { "type": "string", "description": "Project RERA license" },
        "projectType": { "type": "string", "description": "Residential, Plotted, Commercial, Villa" },
        "stage": { "type": "string", "description": "Pre-Launch, Under Construction, Ready to Move" },
        "landArea": { "type": "string", "description": "Land size e.g. 25 Acres" },
        "totalUnits": { "type": "number", "description": "Total inventory units" },
        "availableUnits": { "type": "number", "description": "Available unsold units" },
        "blockedUnits": { "type": "number", "description": "Units currently on hold" },
        "soldUnits": { "type": "number", "description": "Booked or sold units" },
        "startingPrice": { "type": "number", "description": "Starting price in INR" },
        "bspPerSqFt": { "type": "number", "description": "Base selling price per sq.ft or gaj" },
        "configurations": { "type": "string", "description": "JSON array of available configurations" },
        "possessionDate": { "type": "string", "description": "Estimated possession timeline" }
      },
      "required": ["id", "name", "developerName", "location", "projectType"]
    },
    "brokers": {
      "title": "Brokers",
      "description": "Channel partners, real estate brokers, sourcing agents, and firms",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "name": { "type": "string", "description": "Broker or principal partner name" },
        "firmName": { "type": "string", "description": "Real estate agency name" },
        "mobile": { "type": "string", "description": "10-digit mobile number" },
        "email": { "type": "string", "description": "Broker email" },
        "reraNumber": { "type": "string", "description": "Channel partner RERA certificate" },
        "tier": { "type": "string", "description": "Platinum, Gold, Silver, Standard" },
        "city": { "type": "string", "description": "Operating territory" },
        "commissionRatePercent": { "type": "number", "description": "Brokerage commission percentage" },
        "status": { "type": "string", "description": "Verified, Pending, Blocked" },
        "totalBrokerageEarned": { "type": "number", "description": "Total commission earned in INR" },
        "totalBrokeragePaid": { "type": "number", "description": "Total payout cleared in INR" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "name", "firmName", "mobile"]
    },
    "units": {
      "title": "Units",
      "description": "Individual inventory flats, plots, floors, and commercial units",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "projectId": { "type": "string", "description": "Associated project ID" },
        "unitNumber": { "type": "string", "description": "Unit or flat or plot number" },
        "towerOrBlock": { "type": "string", "description": "Tower, phase, or block name" },
        "floor": { "type": "number", "description": "Floor level" },
        "unitType": { "type": "string", "description": "Configuration e.g. 3 BHK or 150 Gaj" },
        "sizeSqFtOrGaj": { "type": "string", "description": "Size measurement" },
        "facing": { "type": "string", "description": "Facing orientation" },
        "basePrice": { "type": "number", "description": "Base price in INR" },
        "status": { "type": "string", "description": "Available, Blocked, Booked" },
        "bookedByLeadName": { "type": "string", "description": "Client name if booked" },
        "bookedByBrokerName": { "type": "string", "description": "Channel partner if sourced" }
      },
      "required": ["id", "projectId", "unitNumber", "status"]
    },
    "site_visits": {
      "title": "Site Visits",
      "description": "Customer site inspections and property visit logs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "leadId": { "type": "number", "description": "Associated lead id" },
        "leadName": { "type": "string", "description": "Lead customer name" },
        "mobile": { "type": "string", "description": "Lead phone number" },
        "projectId": { "type": "string", "description": "Project ID" },
        "projectName": { "type": "string", "description": "Project Name" },
        "salesperson": { "type": "string", "description": "Assigned executive" },
        "visitDate": { "type": "string", "description": "Scheduled or completed visit date" },
        "status": { "type": "string", "description": "Scheduled, Completed, Cancelled, Rescheduled" },
        "cabAssigned": { "type": "boolean", "description": "Whether cab was provided" },
        "feedback": { "type": "string", "description": "Customer feedback" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "leadName", "projectName", "visitDate", "status"]
    },
    "cost_sheets": {
      "title": "Cost Sheets",
      "description": "Detailed real estate property pricing and payment breakdown sheets",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "projectName": { "type": "string", "description": "Project name" },
        "unitType": { "type": "string", "description": "Configuration" },
        "totalCost": { "type": "number", "description": "All inclusive total cost in INR" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "projectName", "totalCost"]
    },
    "tokens_agreements": {
      "title": "Tokens and Agreements",
      "description": "Booking token receipts, builder buyer agreements (BBA), and registry records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "leadName": { "type": "string", "description": "Customer name" },
        "projectName": { "type": "string", "description": "Project name" },
        "tokenAmount": { "type": "number", "description": "Token amount received" },
        "status": { "type": "string", "description": "Agreement status" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "leadName", "projectName", "tokenAmount"]
    },
    "deals": {
      "title": "Deals",
      "description": "Sales pipeline deals and transactions across stages",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "title": { "type": "string", "description": "Deal title or description" },
        "leadId": { "type": "number", "description": "Associated lead ID" },
        "leadName": { "type": "string", "description": "Client name" },
        "mobile": { "type": "string", "description": "Client mobile" },
        "projectId": { "type": "string", "description": "Project ID" },
        "projectName": { "type": "string", "description": "Project name" },
        "unitNumber": { "type": "string", "description": "Unit or plot number" },
        "dealValue": { "type": "number", "description": "Total deal value in INR" },
        "stage": { "type": "string", "description": "Pipeline stage" },
        "probability": { "type": "number", "description": "Closing probability percentage" },
        "assignedTo": { "type": "string", "description": "Sales executive name" },
        "expectedCloseDate": { "type": "string", "description": "Expected closing date" },
        "notes": { "type": "string", "description": "Deal notes" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "title", "leadName", "dealValue", "stage", "assignedTo"]
    },
    "tasks": {
      "title": "Tasks",
      "description": "Sales follow-up and operational action tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "title": { "type": "string", "description": "Task summary" },
        "type": { "type": "string", "description": "Call, Follow-up, Site Visit, Document, Meeting, Other" },
        "priority": { "type": "string", "description": "High, Medium, Low" },
        "status": { "type": "string", "description": "Pending, In Progress, Completed, Cancelled" },
        "assignedTo": { "type": "string", "description": "Sales executive" },
        "leadId": { "type": "number", "description": "Associated lead ID" },
        "leadName": { "type": "string", "description": "Client name" },
        "dueDate": { "type": "string", "description": "Due date" },
        "dueTime": { "type": "string", "description": "Due time" },
        "description": { "type": "string", "description": "Task details" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "title", "type", "priority", "status", "assignedTo", "dueDate"]
    },
    "meetings": {
      "title": "Meetings",
      "description": "Daily scheduled customer meetings, sales presentations, negotiations, and minutes of meeting",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "meetingNumber": { "type": "string", "description": "Meeting reference code" },
        "title": { "type": "string", "description": "Meeting agenda or headline" },
        "leadId": { "type": "number", "description": "Associated lead ID" },
        "clientName": { "type": "string", "description": "Client or investor name" },
        "clientMobile": { "type": "string", "description": "Phone number" },
        "clientEmail": { "type": "string", "description": "Email address" },
        "projectName": { "type": "string", "description": "Real estate project" },
        "salesperson": { "type": "string", "description": "Assigned executive" },
        "meetingDate": { "type": "string", "description": "Scheduled date YYYY-MM-DD" },
        "startTime": { "type": "string", "description": "Start time HH:mm" },
        "endTime": { "type": "string", "description": "End time HH:mm" },
        "meetingType": { "type": "string", "description": "Meeting format or venue" },
        "stage": { "type": "string", "description": "Pipeline stage" },
        "locationOrLink": { "type": "string", "description": "Physical room or virtual meet link" },
        "agenda": { "type": "string", "description": "Discussion objectives" },
        "discussionPoints": { "type": "string", "description": "Meeting minutes notes" },
        "outcome": { "type": "string", "description": "Result or conclusion" },
        "nextStepDate": { "type": "string", "description": "Next scheduled follow-up date" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["id", "title", "clientName", "meetingDate", "startTime", "meetingType", "stage", "salesperson"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /leads/{leadId} {\n      allow read, write: if true;\n    }\n    match /calls/{callId} {\n      allow read, write: if true;\n    }\n    match /users/{userId} {\n      allow read, write: if true;\n    }\n    match /developers/{devId} {\n      allow read, write: if true;\n    }\n    match /projects/{projId} {\n      allow read, write: if true;\n    }\n    match /brokers/{brokerId} {\n      allow read, write: if true;\n    }\n    match /units/{unitId} {\n      allow read, write: if true;\n    }\n    match /site_visits/{visitId} {\n      allow read, write: if true;\n    }\n    match /cost_sheets/{sheetId} {\n      allow read, write: if true;\n    }\n    match /tokens_agreements/{recordId} {\n      allow read, write: if true;\n    }\n    match /deals/{dealId} {\n      allow read, write: if true;\n    }\n    match /tasks/{taskId} {\n      allow read, write: if true;\n    }\n    match /meetings/{meetingId} {\n      allow read, write: if true;\n    }\n  }\n}"
}
